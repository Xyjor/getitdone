generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// Roles for people a list is shared with. The owner is List.userId and has no member row.
enum MemberRole {
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Throwaway sandbox account created by the "Try the demo" button.
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  lists        List[]       @relation("ListOwner")
  createdTasks Task[]       @relation("TaskCreator")
  legacyTasks  Task[]       @relation("TaskLegacyUser")
  memberships  ListMember[]
  sentInvites  ListInvite[]
  sessions     Session[]
}

/// One signed-in browser/device. A session JWT is only valid while its row exists,
/// which is what makes logout, "log out everywhere" and password changes revoke access.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters for rate limiting. `key` is a SHA-256 hash (no raw IPs/emails stored).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model List {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("slate")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  /// The owner. Deleting the owner deletes the list (and its tasks, members and invites).
  userId  String
  user    User         @relation("ListOwner", fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  members ListMember[]
  invites ListInvite[]

  @@index([userId, position])
}

/// Someone a list is shared with.
model ListMember {
  id        String     @id @default(cuid())
  listId    String
  list      List       @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole
  createdAt DateTime   @default(now())

  @@unique([listId, userId])
  @@index([userId])
}

/// A pending invitation, matched to users by email (no email is sent; it appears in the app).
model ListInvite {
  id          String     @id @default(cuid())
  listId      String
  list        List       @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Normalized (trimmed, lowercase), same rules as sign-up.
  email       String
  role        MemberRole
  invitedById String
  invitedBy   User       @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  expiresAt   DateTime

  @@unique([listId, email])
  @@index([email])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  notes     String?
  completed Boolean   @default(false)
  dueDate   DateTime? @db.Date
  priority  Priority  @default(MEDIUM)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listId      String
  list        List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Who added the task. Access comes from the list, not from this. Kept (as null) if that
  /// person deletes their account, so their tasks don't vanish from lists shared with them.
  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// DEPRECATED: the old "userId" column (expand/contract migration). No longer written or
  /// read; still present so the previously deployed version keeps working during this deploy.
  /// Dropped in the next migration.
  legacyUserId String? @map("userId")
  legacyUser   User?   @relation("TaskLegacyUser", fields: [legacyUserId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([legacyUserId])
  @@index([listId, position])
}
