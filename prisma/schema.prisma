generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Throwaway sandbox account created by the "Try the demo" button.
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  lists    List[]
  tasks    Task[]
  sessions Session[]
}

/// One signed-in browser/device. A session JWT is only valid while its row exists,
/// which is what makes logout, "log out everywhere" and password changes revoke access.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters for rate limiting. `key` is a SHA-256 hash (no raw IPs/emails stored).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model List {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("slate")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([userId, position])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  notes     String?
  completed Boolean   @default(false)
  dueDate   DateTime? @db.Date
  priority  Priority  @default(MEDIUM)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listId, position])
}
