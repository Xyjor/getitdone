# Copy this file to .env and adjust as needed.

# Local Docker database (see docker-compose.yml).
# In production, use your Neon connection string instead.
DATABASE_URL="postgresql://getitdone:getitdone@localhost:5432/getitdone?schema=public"

# Optional: direct (non-pooled) connection used by Prisma migrations.
# With Neon, this is the same URL without "-pooler" in the hostname.
# DIRECT_URL="postgresql://..."

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"
